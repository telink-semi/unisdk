#define UPDATE_FLASH_PTR(section) \
    FLASH_PTR = LOADADDR(section) + SIZEOF(section);

#if (CONFIG_TLK_PM_RAM_RETENTION_ENABLE)
    #define RAM_DLM_IF_NON_RET RAM_ILM_RET
    #define RAM_ILM_NON_RET_LENGTH (UNISDK_CHIP_MEMORY_IRAM_SIZE * 1024 - CONFIG_TLK_PM_RETENTION_MEMORY_SIZE * 1024)
#else
    #define RAM_DLM_IF_NON_RET RAM_DLM 
#endif

MEMORY
{
    FLASH   (xr)        : ORIGIN = UNISDK_CHIP_MEMORY_ROM_STARTADDR, LENGTH = UNISDK_CHIP_MEMORY_ROM_SIZE * 1024
#if (CONFIG_TLK_PM_RAM_RETENTION_ENABLE)
    RAM_ILM_RET (xw)    : ORIGIN = UNISDK_CHIP_MEMORY_IRAM_STARTADDR, LENGTH = CONFIG_TLK_PM_RETENTION_MEMORY_SIZE * 1024

    #if (RAM_ILM_NON_RET_LENGTH == 0)
        #define RAM_ILM RAM_ILM_RET
    #else
        RAM_ILM (xw)    : ORIGIN = UNISDK_CHIP_MEMORY_IRAM_STARTADDR + CONFIG_TLK_PM_RETENTION_MEMORY_SIZE * 1024, LENGTH = RAM_ILM_NON_RET_LENGTH
    #endif

#else
    RAM_ILM (xw)        : ORIGIN = UNISDK_CHIP_MEMORY_IRAM_STARTADDR, LENGTH = UNISDK_CHIP_MEMORY_IRAM_SIZE * 1024
    #define RAM_ILM_RET RAM_ILM

#endif
    RAM_DLM (w)         : ORIGIN = UNISDK_CHIP_MEMORY_DRAM_STARTADDR, LENGTH = UNISDK_CHIP_MEMORY_DRAM_SIZE * 1024
}

/* Flash storage areas definitions */
_user_flash_storage_size           = 0K;     /* user flash storage area size, aligh 4K */

ASSERT (_user_flash_storage_size % 4K == 0, "user flash area size should be x4K");

PROVIDE(NDS_SAG_LMA_FLASH                    = ORIGIN(FLASH));
PROVIDE(NDS_SAG_LMA_FLASH_USER_STORAGE_BEGIN = ORIGIN(FLASH) + LENGTH(FLASH) - _user_flash_storage);
PROVIDE(NDS_SAG_LMA_FLASH_END                = NDS_SAG_LMA_FLASH_USER_STORAGE_BEGIN);


ENTRY(_RESET_ENTRY)

/* Generate a link error if heap and stack don't fit into RAM_RETENTION */
#ifndef CONFIG_TLK_MEMORY_HEAP_SIZE 
#define CONFIG_TLK_MEMORY_HEAP_SIZE 0
#endif

_Heap_Size  = CONFIG_TLK_MEMORY_HEAP_SIZE * 1024;          /* required amount of heap  */
_Stack_Size = CONFIG_TLK_MEMORY_STACK_SIZE * 1024;          /* required amount of stack */

FLASH_PTR = ORIGIN(FLASH);

SECTIONS
{
    .vectors : AT(ALIGN(FLASH_PTR, 4))  ALIGN(4)
    {
        KEEP(*(.vectors))
    } > FLASH
    UPDATE_FLASH_PTR(.vectors)

    .text : AT(ALIGN(FLASH_PTR, 4))  ALIGN(4)
    {
        *(.text .stub .text.* .gnu.linkonce.t.*)
        KEEP(*(.text.*personality*))
        *(.gnu.warning)
    } > FLASH
    UPDATE_FLASH_PTR(.text)

    .rodata : AT(ALIGN(FLASH_PTR, 4))  ALIGN(4)
    {
        *(.rodata .rodata.* .gnu.linkonce.r.* )
        *(.srodata.cst16)
        *(.srodata.cst8)
        *(.srodata.cst4)
        *(.srodata.cst2)
        *(.srodata .srodata.*)
    } > FLASH
    UPDATE_FLASH_PTR(.rodata)

    .init_array : AT(ALIGN(FLASH_PTR, 4))  ALIGN(4)
    {
        PROVIDE_HIDDEN(__init_array_start = .);
        KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*)))
        KEEP(*(.init_array))
        PROVIDE_HIDDEN(__init_array_end = .);
    } > FLASH
    UPDATE_FLASH_PTR(.init_array)

    .fini_array : AT(ALIGN(FLASH_PTR, 4))  ALIGN(4)
    {
        PROVIDE_HIDDEN(__fini_array_start = .);
        KEEP(*(SORT_BY_INIT_PRIORITY(.fini_array.*)))
        KEEP(*(.fini_array))
        PROVIDE_HIDDEN(__fini_array_end = .);
    } > FLASH
    UPDATE_FLASH_PTR(.fini_array)

    .eh_frame_hdr : AT(FLASH_PTR)
    {
        *(.eh_frame_hdr)
    } > FLASH
    UPDATE_FLASH_PTR(.eh_frame_hdr)

    .eh_frame : AT(FLASH_PTR)
    {
        KEEP(*(.eh_frame))
    } > FLASH
    UPDATE_FLASH_PTR(.eh_frame)

    .ctors : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        KEEP(*crtbegin*.o(.ctors))
        KEEP(*(EXCLUDE_FILE (*crtend*.o) .ctors))
        KEEP(*(SORT(.ctors.* )))
        KEEP(*(.ctors ))
    } > FLASH
    UPDATE_FLASH_PTR(.ctors)

    .dtors : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        KEEP(*crtbegin*.o(.dtors))
        KEEP(*(EXCLUDE_FILE (*crtend*.o) .dtors))
        KEEP(*(SORT(.dtors.* )))
        KEEP(*(.dtors ))
    } > FLASH
    UPDATE_FLASH_PTR(.dtors)

    .pre_init_array : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        PROVIDE(__pre_init_start = .);
        KEEP(*(SORT(.pre_init_array*)))
        PROVIDE(__pre_init_end = .);
    } > FLASH
    UPDATE_FLASH_PTR(.pre_init_array)

    .loop_array : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        PROVIDE(__loop_start = .);
        KEEP(*(.loop_array))
        PROVIDE(__loop_end = .);
    } > FLASH
    UPDATE_FLASH_PTR(.loop_array)

    .before_suspend_array : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        PROVIDE(__before_suspend_start = .);
        KEEP(*(SORT(.before_suspend_array*)))
        PROVIDE(__before_suspend_end = .);
    } > FLASH
    UPDATE_FLASH_PTR(.before_suspend_array)

    .after_suspend_array : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        PROVIDE(__after_suspend_start = .);
        KEEP(*(SORT(.after_suspend_array*)))
        PROVIDE(__after_suspend_end = .);
    } > FLASH
    UPDATE_FLASH_PTR(.after_suspend_array)

    .before_sleep_array : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        PROVIDE(__before_sleep_start = .);
        KEEP(*(SORT(.before_sleep_array*)))
        PROVIDE(__before_sleep_end = .);
    } > FLASH
    UPDATE_FLASH_PTR(.before_sleep_array)

    .after_sleep_array : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        PROVIDE(__after_sleep_start = .);
        KEEP(*(SORT(.after_sleep_array*)))
        PROVIDE(__after_sleep_end = .);
    } > FLASH
    UPDATE_FLASH_PTR(.after_sleep_array)

    .prevent_suspend_array : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        PROVIDE(__prevent_suspend_start = .);
        KEEP(*(.prevent_suspend_array))
        PROVIDE(__prevent_suspend_end = .);
    } > FLASH
    UPDATE_FLASH_PTR(.prevent_suspend_array)

    .prevent_sleep_array : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        PROVIDE(__prevent_sleep_start = .);
        KEEP(*(.prevent_sleep_array))
        PROVIDE(__prevent_sleep_end = .);
    } > FLASH
    UPDATE_FLASH_PTR(.prevent_sleep_array)


    .rf_certification_cfg : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    { 
        PROVIDE(__rf_certification_begin = .);
        KEEP(*(.rf_certification_cfg)) 
        PROVIDE(__rf_certification_end = .);
    } > FLASH
    UPDATE_FLASH_PTR(.rf_certification_cfg)

    /* Start of RAM description */

    /* Should be placed at zero address, which is start of ILM RAM */
    .retention_reset : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        PROVIDE(_RETENTION_RESET_VMA_START = .);
        KEEP(*(.retention_reset))
        PROVIDE_HIDDEN(_RETENTION_RESET_VMA_END = .);
    } > RAM_ILM_RET
    PROVIDE(_RETENTION_RESET_LMA_START = LOADADDR(.retention_reset));
    UPDATE_FLASH_PTR(.retention_reset)

    ._stack (NOLOAD) : ALIGN(16)
    {
        . = . + _Stack_Size;
        PROVIDE(_STACK_TOP = .);
    } > RAM_DLM_IF_NON_RET

    /* By default,the aes_data section can only be used in the first 64K of IRAM, */
    /* please do not change the position of this section,unless you know the correct way to use */
    .aes_data (NOLOAD) :
    {
        PROVIDE(_AES_VMA_START = .);
        KEEP(*(.aes_data))
        PROVIDE(_AES_VMA_END = .);
    } > RAM_ILM_RET

    .ram_code : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        PROVIDE(_RAMCODE_VMA_START = .);
        KEEP(*(.ram_code))
        PROVIDE(_RAMCODE_VMA_END = .);
    } > RAM_ILM_RET
    PROVIDE(_RAMCODE_LMA_START = LOADADDR(.ram_code));
    UPDATE_FLASH_PTR(.ram_code)

    .exec.itable : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        PROVIDE(_EXECIT_VMA_START = .);
        KEEP(*(.exec.itable))
        PROVIDE(_EXECIT_VMA_END = .);
    } > RAM_ILM_RET
    PROVIDE(_EXECIT_LMA_START = LOADADDR(.exec.itable));
    UPDATE_FLASH_PTR(.exec.itable)

    .tasks_array : AT(ALIGN(FLASH_PTR, 8)) ALIGN(8)
    {
        PROVIDE(__tasks_start = .);
        KEEP(*(.tasks_array.tasks))
        PROVIDE(__tasks_end = .);
        PROVIDE(__timers_start = .);
        KEEP(*(.tasks_array.timers))
        PROVIDE(__timers_end = .);
    } > RAM_DLM_IF_NON_RET
    PROVIDE(_TASKS_ARRAY_LMA_START = LOADADDR(.tasks_array));
    UPDATE_FLASH_PTR(.tasks_array)   

    .data : AT(ALIGN(FLASH_PTR, 4)) ALIGN(4)
    {
        PROVIDE (__global_pointer$ = . + 0x800);
        PROVIDE(_DATA_VMA_START = .);
        *(.data .data.* .gnu.linkonce.d.*)
        KEEP(*(.gnu.linkonce.d.*personality*))
        SORT(CONSTRUCTORS)
        *(.srodata.cst16)
        *(.srodata.cst8)
        *(.srodata.cst4)
        *(.srodata.cst2)
        *(.srodata .srodata.*)
        *(.sdata .sdata.* .gnu.linkonce.s.*)
        *(.sdata2 .sdata2.* .gnu.linkonce.s.*)
        PROVIDE(_DATA_VMA_END = .);
    } > RAM_DLM_IF_NON_RET
    PROVIDE(_DATA_LMA_START = LOADADDR(.data));
    UPDATE_FLASH_PTR(.data)
    
    .bss (NOLOAD) : ALIGN(4)
    {
        PROVIDE(_BSS_VMA_START = .);
        *(.dynsbss )
        *(.sbss .sbss.* .gnu.linkonce.sb.* )
        *(.scommon .scommon.* )
        *(.dynbss)
        *(.bss .bss.* .gnu.linkonce.b.*)
        *(COMMON)
        PROVIDE(_BSS_VMA_END = .);
    } > RAM_DLM_IF_NON_RET

    ._user_heap (NOLOAD) : ALIGN(16)
    {   
        PROVIDE(_end = .);
    } > RAM_DLM_IF_NON_RET
}

PROVIDE(BIN_SIZE = FLASH_PTR - ORIGIN(FLASH));
PROVIDE(NDS_SAG_LMA_FLASH_BL = ALIGN(FLASH_PTR, 4K));

#if (CONFIG_TLK_PM_RAM_RETENTION_ENABLE)
    ASSERT(
        SIZEOF(.retention_reset) + 
        SIZEOF(._stack) +
        SIZEOF(.aes_data) + 
        SIZEOF(.ram_code) + 
        SIZEOF(.exec.itable) +
        SIZEOF(.data) + 
        SIZEOF(.bss) <= LENGTH(RAM_ILM_RET), "RAM_ILM_RET overflow!")
#else
    ASSERT(
        SIZEOF(.retention_reset) + 
        SIZEOF(.aes_data) + 
        SIZEOF(.ram_code) + 
        SIZEOF(.exec.itable) <= LENGTH(RAM_ILM),
        "RAM_ILM overflow!")
    ASSERT(
        SIZEOF(._stack) +
        SIZEOF(.data) + 
        SIZEOF(.bss) <= LENGTH(RAM_DLM),
        "RAM_DLM overflow!")
#endif
ASSERT((BIN_SIZE) <= LENGTH(FLASH), "BIN FILE OVERFLOW");

