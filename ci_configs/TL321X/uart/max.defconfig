CONFIG_TLK_API_SLEEP=y
CONFIG_TLK_DMA=y
CONFIG_TLK_DMA_IRQ_HANDLER=y
CONFIG_TLK_PM=y
CONFIG_TLK_UART0_ENABLED=y
CONFIG_TLK_UART0_FLOW_CONTROL_RTS_CTS=y
CONFIG_TLK_UART0_FLOW_CONTROL=y
CONFIG_TLK_UART0_TX_MODE="TLK_UART_XFER_BLOCKING"
CONFIG_TLK_UART0_RX_MODE="TLK_UART_XFER_BLOCKING"
CONFIG_TLK_UART0_PM_DEVICE=y
CONFIG_TLK_UART0_PREVENT_SLEEP=y
CONFIG_TLK_UART1_ENABLED=y
CONFIG_TLK_UART1_AUTO_CONFIG=y
CONFIG_TLK_UART1_FLOW_CONTROL_RTS_CTS=y
CONFIG_TLK_UART1_FLOW_CONTROL=y
CONFIG_TLK_UART1_TX_MODE="TLK_UART_XFER_BLOCKING"
CONFIG_TLK_UART1_RX_MODE="TLK_UART_XFER_BLOCKING"
CONFIG_TLK_UART1_PM_DEVICE=y
CONFIG_TLK_UART1_PREVENT_SLEEP=y
CONFIG_TLK_UART2_ENABLED=y
CONFIG_TLK_UART2_AUTO_CONFIG=y
CONFIG_TLK_UART2_FLOW_CONTROL_RTS_CTS=y
CONFIG_TLK_UART2_FLOW_CONTROL=y
CONFIG_TLK_UART2_TX_MODE="TLK_UART_XFER_BLOCKING"
CONFIG_TLK_UART2_RX_MODE="TLK_UART_XFER_BLOCKING"
CONFIG_TLK_UART2_PM_DEVICE=y
CONFIG_TLK_UART2_PREVENT_SLEEP=y
CONFIG_TLK_DEBUG_PRINT=y
