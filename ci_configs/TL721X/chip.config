CONFIG_TLK_CORE_TL721X=y
CONFIG_TLK_CORE="TL721X"
CONFIG_TLK_HAS_QFN88_CASE=y
CONFIG_TLK_CASE="QFN88"
# CONFIG_TLK_SOC_SERIES_TL321X is not set
CONFIG_TLK_SOC_SERIES_TL721X=y
# CONFIG_TLK_SOC_SERIES_TLSR922X is not set
# CONFIG_TLK_SOC_SERIES_TLSR952X is not set
CONFIG_TLK_SOC_SERIES="TL721X"
CONFIG_TLK_SOC="TL7218X"
CONFIG_TLK_SOC_TL7218X=y
# CONFIG_TLK_SOC_TL7218A is not set
# CONFIG_TLK_SOC_TL7218D is not set
# CONFIG_TLK_SOC_TL7218H is not set
# CONFIG_TLK_SOC_TL7218J is not set
# CONFIG_TLK_SOC_TL7215A is not set
# CONFIG_TLK_SOC_TL7215D is not set
CONFIG_TLK_HAS_BOARD_SELECTED=y
CONFIG_TLK_BOARD_TL7218X_EVK=y
CONFIG_TLK_BOARD="TL7218X_EVK"
