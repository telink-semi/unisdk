menu "IRQ Sample configuration"

choice TLK_IRQ_DEMO_IRQ_BASE
    prompt "Interrupt nesting base"
    default TLK_IRQ_DEMO_IRQ_BASE_PLIC_SW

config TLK_IRQ_DEMO_IRQ_BASE_PLIC_SW
    bool "PLIC_SW (MSI)"

config TLK_IRQ_DEMO_IRQ_BASE_MTIMER
    bool "MTIMER (MTI)"

config TLK_IRQ_DEMO_IRQ_BASE_PLIC
    bool "PLIC (MEI)"
endchoice


config TLK_IRQ_DEMO_PLIC_PREEMPT
    bool "PLIC with PREEMPT"
    select TLK_PLIC_NEST_PLIC
    depends on TLK_IRQ_DEMO_IRQ_BASE_PLIC

endmenu
