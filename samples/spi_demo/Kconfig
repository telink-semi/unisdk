config TLK_SPI_DEMO
    def_bool y
    select TLK_SPI
    select TLK_API_TIME

menu "SPI Sample configuration"

choice
    prompt "Device role"

config TLK_SPI_DEMO_ROLE_MASTER
    bool "Master"
    select TLK_SPI0_MASTER

config TLK_SPI_DEMO_ROLE_SLAVE
    bool "Slave"
    select TLK_SPI0_SLAVE

endchoice

endmenu
