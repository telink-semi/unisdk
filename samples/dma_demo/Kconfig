config TLK_DMA_DEMO
    def_bool y
    select TLK_DMA
    select TLK_API_PRINT # TODO: change to log
    select TLK_API_TIME


menu "DMA Sample configuration"

config TLK_DMA_DEMO_INTERRUPT
    bool "DMA demo with interrupt"
    select TLK_PLIC
    select TLK_DMA_IRQ_HANDLER
    
config TLK_DMA_DEMO_SLEEP
    bool "DMA demo with sleep"
    select TLK_API_SLEEP
    imply TLK_DMA_PM_DEVICE

config TLK_DMA_DEMO_PREVENT
    bool "DMA demo with prevent"
    select TLK_PM
    select TLK_PM_SUSPEND
    select TLK_DMA_PREVENT_SLEEP

endmenu
