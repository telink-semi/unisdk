CONFIG_TLK_CORE_TL321X=y
CONFIG_TLK_CORE="TL321X"
CONFIG_TLK_HAS_QFN64_CASE=y
CONFIG_TLK_CASE="QFN64"
CONFIG_TLK_SOC_SERIES_TL321X=y
# CONFIG_TLK_SOC_SERIES_TL721X is not set
# CONFIG_TLK_SOC_SERIES_TLSR922X is not set
# CONFIG_TLK_SOC_SERIES_TLSR952X is not set
CONFIG_TLK_SOC_SERIES="TL321X"
CONFIG_TLK_SOC_TL3218X=y
# CONFIG_TLK_SOC_TL3219D is not set
# CONFIG_TLK_SOC_TL3218B is not set
# CONFIG_TLK_SOC_TL3218K is not set
# CONFIG_TLK_SOC_TL3218E is not set
# CONFIG_TLK_SOC_TL3218F is not set
# CONFIG_TLK_SOC_TL3215C is not set
CONFIG_TLK_SOC="TL3218X"
CONFIG_TLK_HAS_BOARD_SELECTED=y
CONFIG_TLK_BOARD_TL3218X_EVK=y
CONFIG_TLK_BOARD="TL3218X_EVK"
